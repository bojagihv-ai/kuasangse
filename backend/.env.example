# Vertex AI (recommended billing route)
GOOGLE_GENAI_USE_VERTEXAI=True
GOOGLE_CLOUD_PROJECT=your_gcp_project_id
GOOGLE_CLOUD_LOCATION=global
# Optional (recommended in server environments): service account JSON path
# GOOGLE_APPLICATION_CREDENTIALS=C:\\secure\\vertex-sa.json

# Gemini Developer API fallback (set only when not using Vertex AI)
# GEMINI_API_KEY=your_gemini_api_key_here

SERPAPI_KEY=your_serpapi_key_here
