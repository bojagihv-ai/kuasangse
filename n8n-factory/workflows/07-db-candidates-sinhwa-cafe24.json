        "specifyBody": "json",
        "jsonBody": "={\n  \"query\": {\n    \"q\": {{JSON.stringify($('Config Ready').item.json.query)}},\n    \"limit\": {{$('Config Ready').item.json.limit}}\n  }\n}",
