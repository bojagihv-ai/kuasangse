      "id": "a7000007-0007-4000-8000-000000000008",
      "name": "Cafe24 Products Search",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        120
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Config Ready').first().json;\nfunction arr(data) {\n  if (Array.isArray(data)) return data;\n  const body = data?.response?.body ?? data?.body ?? data;\n  if (Array.isArray(body)) return body;\n  if (Array.isArray(body?.products)) return body.products;\n  if (Array.isArray(body?.items)) return body.items;\n  if (Array.isArray(body?.results)) return body.results;\n  if (Array.isArray(body?.value)) return body.value;\n  return [];\n}\nfunction pick(name) {\n  try { return $(name).first().json; } catch(e) { return null; }\n}\nconst hubSinhwa = pick('Sinhwa Search via API Hub');\nconst directSinhwa = pick('Sinhwa Search Direct 8200');\nconst cafe24 = pick('Cafe24 Products Search');\nconst sinhwaLocal = pick('Sinhwa Local Status');\nconst sinhwaProducts = arr(hubSinhwa).length ? arr(hubSinhwa) : arr(directSinhwa);\nconst cafe24Products = arr(cafe24);\nconst sinhwaSource = arr(hubSinhwa).length ? 'api-hub' : (arr(directSinhwa).length ? 'direct-8200' : 'none');\nreturn [{\n  json: {\n    stage: '07-db-candidates',\n    query: cfg.query,\n    sinhwaLocalStatus: sinhwaLocal,\n    sinhwaSource,\n    sinhwaCount: sinhwaProducts.length,\n    cafe24Count: cafe24Products.length,\n    sinhwaTop: sinhwaProducts.slice(0, 5).map(p => ({\n      name: p.product_name || p.jname || p.name || '',\n      code: p.jcode || p.product_code || p.code || '',\n      score: p.score || p.match_score || null\n    })),\n    cafe24Top: cafe24Products.slice(0, 5).map(p => ({\n      name: p.product_name || p.name || '',\n      product_no: p.product_no || p.productNo || '',\n      product_code: p.product_code || p.productCode || '',\n      price: p.price || p.selling_price || null\n    })),\n    raw: {\n      sinhwaHubOk: !!(hubSinhwa && hubSinhwa.ok !== false),\n      cafe24HubOk: !!(cafe24 && cafe24.ok !== false)\n    },\n    nextStep: '브라우저 조립공장에서 후보 확정 또는 04-generate-all',\n    note: '원본 조립공장 후보 수집 API와 동일 경로. n8n은 검색/상위 후보만 반환하며 자동 확정은 하지 않습니다.'\n  }\n}];"
      },
